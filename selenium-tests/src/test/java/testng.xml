<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MediCore Hospital Management System Test Suite" verbose="1">
    
    <test name="Complete Test Suite - All 15 Tests" preserve-order="true">
        <classes>
            <class name="com.testing.HospitalManagementTest"/>
        </classes>
    </test>
    
    <!-- Optional: Separate test groups -->
    <test name="Smoke Tests Only" enabled="false">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.testing.HospitalManagementTest"/>
        </classes>
    </test>
    
</suite>